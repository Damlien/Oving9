### Main FPGA Clock
set_io clk 15

### LED Pins:
set_io LED1 56
set_io LED2 57
set_io LED3 59
set_io LED4 60

## Push-Button Switches
set_io SW1 53
set_io SW2 51
set_io SW3 54
set_io SW4 52

### 7 Segment Outputs
set_io Segment1_A 3
set_io Segment1_B 4
set_io Segment1_C 93
set_io Segment1_D 91
set_io Segment1_E 90
set_io Segment1_F 1
set_io Segment1_G 2
set_io Segment2_A 100
set_io Segment2_B 99
set_io Segment2_C 97
set_io Segment2_D 95
set_io Segment2_E 94
set_io Segment2_F 8
set_io Segment2_G 96

## UART Outputs
set_io i_UART_RX 73
set_io o_UART_TX 74

## VGA Outputs
set_io o_VGA_HSync 26
set_io o_VGA_VSync 27
set_io o_VGA_Red_0 36
set_io o_VGA_Red_1 37
set_io o_VGA_Red_2 40
set_io o_VGA_Grn_0 29
set_io o_VGA_Grn_1 30
set_io o_VGA_Grn_2 33
set_io o_VGA_Blu_0 28
set_io o_VGA_Blu_1 41
set_io o_VGA_Blu_2 42

########## PMOD connector ################################################
#
#      Pmod           FPGA-pins
#
#     ########       ##########  
#    | 1   7 |     >| 65    78 | 
#    | 2   8 |      | 64    79 | 
#    | 3   9 |      | 63    80 | 
#    | 4  10 |      | 62    81 | 
#    | 5  11 |      | GND  GND | 
#    | 6  12 |      | 3v3  3v3 | 
#     ########       ##########  
set_io -nowarn PMOD1   65
set_io -nowarn PMOD2   64
set_io -nowarn PMOD3   63
set_io -nowarn PMOD4   62
set_io -nowarn PMOD7   78
set_io -nowarn PMOD8   79
set_io -nowarn PMOD9   80
set_io -nowarn PMOD10  81

